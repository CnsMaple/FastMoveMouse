# Example cargo configuration for building this project without MSVC.
#
# The normal Windows setup is the MSVC toolchain and needs none of this file.
# Use it only when Rust is installed with the GNU toolchain instead, for example
# because Visual Studio Build Tools are not available.
#
# Note: Git for Windows ships its own "link.exe", which shadows the MSVC linker.
# If plain "cargo build" fails with "extra operand" from link.exe, that is why.
#
# To use: copy this file to .cargo/config.toml and, if needed, set the linker to
# the path of your own gcc.exe.
[build]
target = "x86_64-pc-windows-gnu"

[target.x86_64-pc-windows-gnu]
linker = "gcc"
